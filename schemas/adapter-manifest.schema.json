{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova-tails.local/schemas/adapter-manifest.schema.json",
  "title": "NOVA TAILS Adapter Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "lane", "character_id", "character_revision", "adapter_version", "preserved_invariants", "allowed_transformations", "validation", "deliverables"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "adapter_id": {"type": "string", "minLength": 1},
    "lane": {"enum": ["game", "print", "card-2d", "content"]},
    "character_id": {"type": "string", "pattern": "^NT-CHAR-[0-9]{3,}$"},
    "character_revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "master_design_revision": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+$"},
    "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "preserved_invariants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_transformations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "validation": {"type": "object", "additionalProperties": true},
    "deliverables": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "object", "additionalProperties": true}
  }
}
